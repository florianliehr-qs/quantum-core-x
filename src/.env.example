# Quantum Core X - Development Environment Configuration
# Copy this file to .env and adjust values as needed
# Usage: docker-compose -f docker-compose.dev.yml --env-file .env up

# ===========================================
# PostgreSQL Database Configuration
# ===========================================
POSTGRES_USER=metin2
POSTGRES_PASSWORD=metin2
POSTGRES_DB=metin2
POSTGRES_PORT=5432

# ===========================================
# Redis Cache Configuration
# ===========================================
REDIS_PORT=6379

# ===========================================
# Game Server Configuration
# ===========================================
GAME_PORT=13001

# Log levels: Trace, Debug, Information, Warning, Error, Critical
LOG_LEVEL_GAME=Information
LOG_LEVEL_EF=Warning

# ===========================================
# Auth Server Configuration
# ===========================================
AUTH_PORT=11002
AUTH_BASE_URL=http://auth:11002

# ===========================================
# Optional: pgAdmin Configuration
# ===========================================
PGADMIN_PORT=5050
PGADMIN_EMAIL=admin@quantumcore.local
PGADMIN_PASSWORD=admin

# ===========================================
# Optional: Redis Commander Configuration
# ===========================================
REDIS_COMMANDER_PORT=8081
